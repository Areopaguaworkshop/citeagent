# CiteAgent Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.

# Scraper API key (if using external scraping service)
# SCRAPER_API_KEY="your-key-here"

# OpenAI / LLM API key (if using AI features)
# OPENAI_API_KEY="your-key-here"

# Any other service credentials
# SERVICE_API_KEY="your-key-here"

# Optional local metadata only. This directory holds paper manifests, workflow
# checkpoints, and opt-in session metadata; it must stay outside source control.
# CITEAGENT_STATE_ROOT="./.citeagent"
